# --- App ---
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://127.0.0.1:8000
# --- Storage ---
STORAGE_DIR=./data
RETENTION_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
# --- Upload limits ---
MAX_UPLOAD_MB=50
MAX_DURATION_SECONDS=600
ALLOWED_EXTENSIONS=.mp3
# --- Processing ---
PROCESSING_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=2
ENGINE=PREFERRED_DEMUCS_FALLBACK_DSP
# Demucs options (used only if demucs+torch installed). One of: htdemucs, htdemucs_ft, hdemucs_mmi
DEMUCS_MODEL=htdemucs
# cpu always works; cuda needs an NVIDIA GPU + CUDA torch build (see requirements-ml-cuda.txt).
# If cuda is configured but unavailable, the app openly falls back to CPU (see /api/engine).
DEMUCS_DEVICE=cpu
# 0 = PyTorch default; measured best on 8C/16T Ryzen: 16 (see MODEL.md). Applies at startup.
TORCH_THREADS=0
# --- Rate limiting ---
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# --- Private tester access (off by default; local use needs nothing) ---
AUTH_ENABLED=false
AUTH_USER=tester
# Credential verifier. Preferred: PBKDF2-HMAC-SHA256
#   pbkdf2$<iterations>$<salt-hex-16B>$<dk-hex-32B>   (600000 iterations recommended)
# Legacy (discouraged for new credentials): plain 64-hex SHA-256 digest.
# Generate a fresh verifier (long random password, never reused, never committed):
#   python -c "import hashlib,secrets; s=secrets.token_bytes(16); print('pbkdf2$600000$'+s.hex()+'$'+hashlib.pbkdf2_hmac('sha256',b'YOUR-PASSWORD',s,600000).hex())"
AUTH_PASS_SHA256=
# Brute-force throttle: wrong-credential attempts per IP before 429s.
# Only attempts WITH wrong credentials count; correct credentials always
# reset the counter and are never locked out.
AUTH_MAX_ATTEMPTS=5
AUTH_BLOCK_WINDOW_SECONDS=300
